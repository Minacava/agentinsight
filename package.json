{
  "name": "agentinsight",
  "version": "0.1.0",
  "description": "CLI for inspecting and debugging LangGraph, Claude Agent SDK, and custom agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentinsight": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate"
  },
  "keywords": [
    "langgraph",
    "claude",
    "agent",
    "cli",
    "debug",
    "tracing",
    "observability"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Minacava/agentinsight.git"
  },
  "bugs": {
    "url": "https://github.com/Minacava/agentinsight/issues"
  },
  "homepage": "https://github.com/Minacava/agentinsight#readme",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@eslint/js": "^9.22.0",
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    }
  }
}
